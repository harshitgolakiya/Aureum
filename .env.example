# MySQL connection used by the Aureum CMS.
DATABASE_URL=mysql://cms_user:change-me@127.0.0.1:3306/aureum

# One-time administrator bootstrap. Used only when cms_users is empty.
# After the first successful startup, normal authentication uses the hashed
# database record and these values can be removed from the runtime environment.
CMS_ADMIN_EMAIL=admin@aureum.ae
CMS_ADMIN_PASSWORD=replace-with-a-strong-password

# Keep this stable across every production instance.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=replace-with-a-stable-32-byte-base64-key

# Private bearer token used by the scheduled-publishing worker. Generate at
# least 32 random characters and never expose it through NEXT_PUBLIC_*.
CMS_CRON_SECRET=replace-with-at-least-32-random-characters

# Optional explicit worker URL. When omitted, the runner uses
# NEXT_PUBLIC_SITE_URL + /api/cron/publish.
CMS_PUBLISH_ENDPOINT=

# Optional pre-authorized disposable database used only by restore QA.
CMS_RESTORE_TEST_DATABASE=

# Canonical origin for the current deployment. Use the temporary Hostinger
# domain now; change this to https://aureum.ae during the final-domain cutover.
NEXT_PUBLIC_SITE_URL=https://darkgray-oryx-870770.hostingersite.com

# Add when an interactive map is approved.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Server-only email notification settings for stored contact enquiries.
# The sender must use a domain verified by your email provider.
RESEND_API_KEY=
CONTACT_FROM_EMAIL=Aureum Website <notifications@aureum.ae>

# Optional private salt used to anonymize contact-form rate-limit identifiers.
CONTACT_RATE_LIMIT_SALT=

# Optional privacy-conscious receiver for Core Web Vitals JSON payloads.
NEXT_PUBLIC_VITALS_ENDPOINT=
